// FactBusiness English — Prisma schema
// Business English learning platform: Level 1 (Basic) → Level 5 (Advanced)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  STUDENT
  ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  BASIC
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  COMPREHENSION
}

enum BookmarkTarget {
  LESSON
  COURSE
}

// ---------------------------------------------------------------- auth

model User {
  id               String    @id @default(cuid())
  firstName        String
  lastName         String
  username         String    @unique
  email            String    @unique
  passwordHash     String
  avatarUrl        String?
  role             Role      @default(STUDENT)
  isActive         Boolean   @default(true)
  xp               Int       @default(0)
  bypassLevelLock  Boolean   @default(false)
  currentLevelId   String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  currentLevel     Level?                @relation("UserCurrentLevel", fields: [currentLevelId], references: [id])
  sessions         Session[]
  quizAttempts     QuizAttempt[]
  listeningAttempts ListeningAttempt[]
  lessonProgress   LessonProgress[]
  topicProgress    TopicProgress[]
  courseProgress   CourseProgress[]
  levelProgress    LevelProgress[]
  bookmarks        Bookmark[]
  notes            Note[]
  certificates     Certificate[]
  achievements     UserAchievement[]
  activities       LearningActivity[]
  readingAttempts  ReadingAttempt[]
  writingSubmissions WritingSubmission[]

  @@index([email])
  @@index([username])
  @@index([currentLevelId])
}

model Session {
  id            String   @id @default(cuid())
  sessionToken  String   @unique
  userId        String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------- content hierarchy

model Level {
  id          String         @id @default(cuid())
  name        String // e.g. "Basic Business English"
  label       String // short label e.g. "Basic"
  slug        String         @unique
  description String
  levelNumber Int            @unique
  published   ContentStatus  @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  courses     Course[]       @relation("LevelCourses")
  users       User[]         @relation("UserCurrentLevel")
  levelProgress LevelProgress[]
  certificates Certificate[]

  @@index([levelNumber])
  @@index([published])
}

model Course {
  id               String        @id @default(cuid())
  levelId          String
  title            String
  slug             String        @unique
  description      String
  shortDescription String
  thumbnail        String?
  order            Int           @default(0)
  published        ContentStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  level   Level   @relation("LevelCourses", fields: [levelId], references: [id], onDelete: Cascade)
  topics  Topic[]
  courseProgress CourseProgress[]

  @@unique([levelId, order])
  @@index([levelId])
}

model Topic {
  id          String        @id @default(cuid())
  courseId    String
  title       String
  slug        String
  description String
  order       Int           @default(0)
  difficulty  Difficulty    @default(BASIC)
  published   ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  grammar Grammar[]

  topicProgress TopicProgress[]

  @@unique([courseId, slug])
  @@unique([courseId, order])
  @@index([courseId])
  @@index([published])
}

model Lesson {
  id              String        @id @default(cuid())
  topicId         String
  title           String
  slug            String
  content         String // markdown lesson body (situation, reading passage, speaking lines)
  objectives      Json
  summary         String?
  order           Int           @default(0)
  durationMinutes Int           @default(15)
  published       ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  topic      Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  vocabulary Vocabulary[]
  listening  ListeningExercise[]
  quiz       Quiz[]
  reading    ReadingExercise[]
  exercises  Exercise[]
  progress   LessonProgress[]
  notes      Note[]

  @@unique([topicId, slug])
  @@unique([topicId, order])
  @@index([topicId])
  @@index([published])
}

// ---------------------------------------------------------------- learning objects

model Vocabulary {
  id              String  @id @default(cuid())
  lessonId        String
  word            String
  pronunciation   String?
  partOfSpeech    String
  thaiMeaning     String?
  meaning         String // English definition / meaning
  example         String
  businessExample String
  audioUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([word])
}

model Grammar {
  id              String   @id @default(cuid())
  topicId         String
  title           String
  explanation     String // the rule, explained
  structure       String
  examples        Json // String[] of example sentences
  businessExamples Json // String[] of business-context examples
  commonMistakes  Json // String[] of common mistakes + corrections
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model ListeningExercise {
  id        String        @id @default(cuid())
  lessonId  String
  title     String
  audioUrl  String? // real audio file/URL; when null the player reads the transcript aloud (browser speech synthesis)
  transcript String
  duration  Int           @default(60) // seconds
  published ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lesson   Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions ListeningQuestion[]
  attempts ListeningAttempt[]

  @@index([lessonId])
}

model ListeningQuestion {
  id               String       @id @default(cuid())
  listeningExerciseId String
  question         String
  type             QuestionType @default(MULTIPLE_CHOICE)
  options          Json // String[] — empty for FILL_BLANK
  answer           String // canonical answer: "A".."D" for choice questions, free text for FILL_BLANK
  explanation      String?
  order            Int          @default(0)
  points           Int          @default(20)

  exercise ListeningExercise @relation(fields: [listeningExerciseId], references: [id], onDelete: Cascade)

  @@unique([listeningExerciseId, order])
  @@index([listeningExerciseId])
}

model Quiz {
  id           String        @id @default(cuid())
  lessonId     String
  title        String
  description  String?
  passingScore Int           @default(70) // percentage
  published    ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
}

model QuizQuestion {
  id          String       @id @default(cuid())
  quizId      String
  question    String
  type        QuestionType @default(MULTIPLE_CHOICE)
  order       Int          @default(0)
  points      Int          @default(5)
  explanation String?

  quiz    Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAttemptAnswer[]

  @@unique([quizId, order])
  @@index([quizId])
}

model QuizOption {
  id         String @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ---------------------------------------------------------------- practice content

model ReadingExercise {
  id        String        @id @default(cuid())
  lessonId  String
  title     String
  passage   String
  questions Json // [{ question, options[], answer, explanation }] — scored server-side
  published ContentStatus @default(DRAFT)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts ReadingAttempt[]

  @@index([lessonId])
}

model Exercise {
  id        String   @id @default(cuid())
  lessonId  String
  kind      String // "WRITING" | "SPEAKING"
  title     String
  prompt    String
  content   Json // writing: example email/reply; speaking: { roles, dialogue:[{speaker,text}], expressions:[] }
  published ContentStatus @default(DRAFT)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions WritingSubmission[]

  @@index([lessonId])
}

// ---------------------------------------------------------------- attempts & progress

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  score          Int // number of correct answers
  totalQuestions Int
  percentage     Int
  passed         Boolean
  startedAt      DateTime @default(now())
  completedAt    DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz  Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([userId])
  @@index([quizId])
  @@index([quizId, userId])
}

model QuizAttemptAnswer {
  id             String  @id @default(cuid())
  attemptId      String
  questionId     String?
  selectedAnswer String? // "A".."D", "TRUE"/"FALSE", or typed text
  isCorrect      Boolean

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([attemptId])
}

model ListeningAttempt {
  id                  String   @id @default(cuid())
  userId              String
  listeningExerciseId String
  score               Int
  totalQuestions      Int
  percentage          Int
  passed              Boolean
  startedAt           DateTime @default(now())
  completedAt         DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise ListeningExercise @relation(fields: [listeningExerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([listeningExerciseId])
  @@index([userId, listeningExerciseId])
}

model ReadingAttempt {
  id                String   @id @default(cuid())
  userId            String
  readingExerciseId String
  score             Int
  totalQuestions    Int
  percentage        Int
  passed            Boolean
  attemptedAt       DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise ReadingExercise @relation(fields: [readingExerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readingExerciseId])
}

model WritingSubmission {
  id                String   @id @default(cuid())
  userId            String
  exerciseId        String
  content           String
  selfReviewed      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@unique([userId, exerciseId])
}

model LessonProgress {
  id                String   @id @default(cuid())
  userId            String
  lessonId          String
  readingCompleted  Boolean  @default(false)
  listeningCompleted Boolean @default(false)
  quizCompleted     Boolean  @default(false)
  completed         Boolean  @default(false)
  progressPercent   Int      @default(0)
  lastViewedAt      DateTime @default(now())
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([userId, completed])
}

model TopicProgress {
  id        String   @id @default(cuid())
  userId    String
  topicId   String
  completed Boolean  @default(false)
  percent   Int      @default(0)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}

model CourseProgress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  completed Boolean  @default(false)
  percent   Int      @default(0)
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model LevelProgress {
  id        String   @id @default(cuid())
  userId    String
  levelId   String
  completed Boolean  @default(false)
  percent   Int      @default(0)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
}

// ---------------------------------------------------------------- user content

model Bookmark {
  id         String         @id @default(cuid())
  userId     String
  targetKind BookmarkTarget // LESSON | COURSE — polymorphic target, resolved by service layer
  targetId   String
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetKind, targetId])
  @@index([userId])
  @@index([targetId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lessonId])
  @@index([userId, lessonId])
}

// ---------------------------------------------------------------- gamification & certificates

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  icon        String @default("🏆")
  xp          Int    @default(0)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

model LearningActivity {
  id           String   @id @default(cuid())
  userId       String
  kind         String // LESSON | LISTENING | QUIZ | EXERCISE | LEVEL
  detail       String?
  activityDate DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, activityDate])
}

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  levelId          String
  certificateId    String   @unique
  verificationCode String   @unique
  issuedAt         DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([levelId])
}
