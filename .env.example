# Neon PostgreSQL (production). Get from https://console.neon.tech after creating a database.
# The -pooler host is the connection-pooled endpoint used at runtime (DATABASE_URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.c-REGION.aws.neon.tech/factenglish?sslmode=require"

# Direct (non-pooled) endpoint. REQUIRED — Prisma CLI (migrate / db push / studio)
# connects through this URL. Same host minus "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.c-REGION.aws.neon.tech/factenglish?sslmode=require"

# Auth secret — generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# Public site URL
NEXTAUTH_URL="https://YOUR-SITE.netlify.app"
NEXT_PUBLIC_APP_URL="https://YOUR-SITE.netlify.app"
